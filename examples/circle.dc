var mybuf
80 24 * mkbuf
mybuf !

: bufadd
  over mybuf @ + swap 1 memset drop
;

: circle-draw
  1024 times
    0
    24 times
      80 times
        i i>f 80.0 1.666 f/ f/ 0.8 f- dup f*
          j i>f 24.0 f/ 0.5 f- dup f*
        f+ fsqrt
        # radius
        k i>f 32.0 f/ fpi f* fcos 0.5 f* 0.5 f+
        0.46 f*
        f< if 42 else 32 endif bufadd
        1 +
      again
    again
    mybuf @ 80 24 * +   0   1   memset drop
    mybuf @ print
    drop
    0.0384 sleep
  again
;

circle-draw
