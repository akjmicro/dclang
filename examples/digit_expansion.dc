"math.dc" import

make_digit_expansion_struct  digits

: show_digit_expansion { base div cols }
  base digits _set_base
  div  digits _set_div
  16 times
    cols times
      digits gen_digit_expansion 3 0 .rj
    again
    cr
  again
;

var test_base
var test_div
var test_rem
var match_rem
var test_q
var test_period
var coverage_word
var coverage_count

: _reset_data_vars { b d }
  b test_base !
  d test_div !
  1 test_rem !
  0 match_rem !
  0 test_q !
  0 test_period !
  0 coverage_word !
  0 coverage_count !
;

"" const :BLANK

: _update_coverage
  1 test_q @ <<
    coverage_word @
  or
  coverage_word !
;

: _get_coverage
  test_base @ times
    coverage_word @ 1 and
    1 = if
      coverage_count @ 1 + coverage_count !
    endif
    coverage_word @ 1 >> coverage_word !
  again
  coverage_count @
;

: _iterate_mod
    test_rem @
      test_div @
      divmod
        test_base @
      *
    test_rem !
  test_q !
;

: _find_period_and_coverage
  _iterate_mod
  _update_coverage
  test_rem @ match_rem @ =
  if
    test_period @ 1 + _get_coverage
  else
    test_period @ 1 + test_period !
    _find_period_and_coverage
  endif
;

# ( b d -- period coverage )
: find_period_and_coverage { b d }
  b d _reset_data_vars
  b d gcd 1 > if
    0 0 return
  endif
  _iterate_mod
  test_rem @ match_rem !
  _find_period_and_coverage
;

"|" const :PIPE
"t" const :TRUE_STR
"f" const :FALSE_STR

: create_digits_database
  # This will write-out a CSV. Can be imported into sqlite3, etc.
  "base|div|period|coverage" print cr
  64 2 1 for
    1024 2 1 for
      j i find_period_and_coverage
      2dup 0 = swap 0 = and
      if
        2drop
      else
        j .. :PIPE print
        i .. :PIPE print
        swap .. :PIPE print
        .. cr
      endif
    next
  next
;
