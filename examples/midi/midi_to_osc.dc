
##################################################
# Config-driven MIDI -> OSC bridge for Faust.    #
#                                                #
# Supports startup introspection, MIDI scaling,  #
# soft takeover, and external OSC change         #
# detection with 500 ms polling.                 #
#                                                #
# Mappings: midi_to_osc.conf                     #
##################################################

"midi.dc" import
"osc.dc"  import

"midi_to_osc.conf"   const :CONFIG_FILE
"r"                  const :READ_MODE
" \t\r"              const :FIELDS
"\n"                 const :NEWLINE
":"                  const :COLON
"127.0.0.1"          const :OSC_HOST
",f"                 const :OSC_FLOAT_TYPE
"Missing controller" const :MISSING_CONTROLLER
"Missing port"       const :MISSING_PORT
"Missing OSC path"   const :MISSING_OSC_PATH
"[INIT] "            const :INIT_MSG
"[WAIT] "            const :WAIT_MSG
"[LATCH] "           const :LATCH_MSG
"[UNLATCH] "         const :UNLATCH_MSG
"[SEND] "            const :SEND_MSG
" value="            const :VALUE_EQ
"Mapped: "           const :MAPPED
" CC="               const :CC_EQ
" target="           const :TARGET_EQ
"Duplicate MIDI mapping: "
                     const :DUPLICATE_MIDI_MAPPING
"Invalid MIDI channel/controller"
                     const :INVALID_MIDI_CHAN
"Invalid OSC port"   const :INVALID_OSC_PORT
" awaiting introspection"
                     const :AWAITING_INTROSPECTION

5520                 const TEST_OSC_PORT
16                   const MAX_OSC_RECEIVERS
2                    const PICKUP_TOLERANCE

# Seconds between introspection cycles.
0.5                  const POLL_INTERVAL

# Ignore potentially stale introspection responses
# briefly after a MIDI-driven OSC send.
0.15                 const SEND_GRACE

# Allowed introspection discrepancy, expressed
# in equivalent MIDI controller steps.
0.5                  const CHANGE_TOLERANCE

# Mapping record offsets.
0 const MAP_CHANNEL
1 const MAP_CC
2 const MAP_PORT
3 const MAP_PATH
4 const MAP_CURRENT
5 const MAP_MINIMUM
6 const MAP_MAXIMUM
7 const MAP_INITIALIZED
8 const MAP_LATCHED
9 const MAP_EXPECTED

10 const MAP_RECORD_SIZE

tmake const MIDI_TREE

var mapping_count
0 mapping_count !

var mapping_base

var rx_count
0 rx_count !
var rx_ports MAX_OSC_RECEIVERS allot
var rx_socks MAX_OSC_RECEIVERS allot

var config_buf
var line_save
var field_save
var current_osc_port

var last_poll
var last_send

64 mkbuf const :KEY_BUF

# ( one_based_index -- record_address )
: mapping_record { idx }
  mapping_base @
  idx 1 - MAP_RECORD_SIZE * +
;

# ( channel cc -- key )
: make_key { channel cc }
  :KEY_BUF 0 64 memset drop

  :KEY_BUF
    channel tostr str+
    :COLON str+
    cc tostr str+
  drop

  :KEY_BUF
;

# ( channel cc port path -- )
: store_mapping { channel cc port path }
  channel ,
  cc ,
  port ,
  path ,
  0 ,  # current
  0 ,  # minimum
  0 ,  # maximum
  0 ,  # initialized
  0 ,  # latched
  0 ,  # expected
;

# ( channel cc port path -- )
: add_mapping { channel cc port path }
  MIDI_TREE channel cc make_key t@
  if
    :DUPLICATE_MIDI_MAPPING print
    channel cc make_key print cr
    return
  endif

  channel cc port path store_mapping

  MIDI_TREE
  channel cc make_key
  mapping_count @ 1 +
  t!

  :MAPPED print
  channel . cc . port .
  path print cr

  mapping_count @ 1 + mapping_count !
;

# ( channel cc port path -- )
: validate_mapping { channel cc port path }
  channel 1 < channel 16 > or
  cc 0 < cc 127 > or
  or
  if
    :INVALID_MIDI_CHAN print cr
    return
  endif

  port 1 < port 65535 > or
  if
    :INVALID_OSC_PORT print cr
    return
  endif

  channel cc port path add_mapping
;

# ( channel-str cc-str port-str path -- )
: parse_mapping_fields { channel cc port path }
  channel tonum
  cc tonum
  port tonum
  path
  validate_mapping
;

# ( line -- )
: parse_line { line }
  line :FIELDS field_save strtok

  dup 0 =
  if
    drop
    return
  endif

  dup ord 35 =
  if
    drop
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    2drop
    :MISSING_CONTROLLER print cr
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    drop 2drop
    :MISSING_PORT print cr
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    drop 2drop drop
    :MISSING_OSC_PATH print cr
    return
  endif

  parse_mapping_fields
;

# ( line -- )
: parse_config_line { line }
  line 0 <>
  if
    line parse_line
    null :NEWLINE line_save strtok
    parse_config_line
  endif
;

: parse_config
  config_buf @ :NEWLINE line_save strtok
  parse_config_line
;

: load_config
  :CONFIG_FILE :READ_MODE fopen

  dup 0 =
  if
    drop
    "Cannot open configuration file" print cr
    return
  endif

  dup freadall
  drop
  config_buf !
  fclose

  parse_config

  "Loaded mappings: " print
  mapping_count @ . cr
;

# ( channel cc -- record_address | -1 )
: lookup_mapping { channel cc }
  MIDI_TREE channel cc make_key t@

  dup 0 =
  if
    drop
    -1
  else
    mapping_record
  endif
;

: init_osc
  :OSC_HOST TEST_OSC_PORT osc_connect
  "OSC test socket initialized" print cr
;

# ( port -- )
: select_osc_port { port }
  port current_osc_port @ <>
  if
    osc_sock @ :OSC_HOST port udpconnect drop
    port current_osc_port !
  endif
;

# ( port path midi_value -- )
: send_test_osc { port path midi_value }
  port select_osc_port

  path :OSC_FLOAT_TYPE osc_message
  midi_value 127.0 / osc_f
  osc_send
;

# ( port path scaled_value -- )
: send_scaled_osc { port path scaled_value }
  port select_osc_port
  path :OSC_FLOAT_TYPE osc_message
  scaled_value osc_f
  osc_send
;

# ( record_address -- )
: request_mapping { record }
  record MAP_PORT + @ select_osc_port
  record MAP_PATH + @ osc_synth_get
;

# ( -- )
: request_all
  mapping_count @ 0 1
  for
    i 1 + mapping_record request_mapping
  next
;

# ( port idx -- flag )
: rx_port_exists_from { port idx }
  idx rx_count @ >=
  if
    0
    return
  endif

  port rx_ports idx + @ =
  if
    1
  else
    port idx 1 + rx_port_exists_from
  endif
;

# ( port -- )
: add_response_socket { port }
  port 0 rx_port_exists_from
  if
    return
  endif

  rx_count @ MAX_OSC_RECEIVERS >=
  if
    "Too many OSC receivers!" print cr
    return
  endif

  port 1 + osc_listen

  port          rx_ports rx_count @ + !
  osc_rx_sock @ rx_socks rx_count @ + !

  rx_count @ 1 + rx_count !
;

# ( -- )
: init_response_sockets
  mapping_count @ 0 1 for
    i 1 + mapping_record
    MAP_PORT + @
    add_response_socket
  next

  "OSC receivers initialized: " print
  rx_count @ . cr
;

# ( input_port path idx -- record_address | -1 )
: lookup_response_from { input_port path idx }
  idx mapping_count @ >=
  if
    -1
    return
  endif

  idx 1 + mapping_record
  dup MAP_PORT + @ input_port =
  over MAP_PATH + @ path str=
  and
  if
    # Return record address.
  else
    drop
    input_port path idx 1 + lookup_response_from
  endif
;

# ( input_port path -- record_address | -1 )
: lookup_response { input_port path }
  input_port path 0 lookup_response_from
;

# ( record current minim maxim -- )
: init_record { record current minim maxim }
  current record MAP_CURRENT + !
  minim record MAP_MINIMUM + !
  maxim record MAP_MAXIMUM + !
  current record MAP_EXPECTED + !
  0 record MAP_LATCHED + !
  1 record MAP_INITIALIZED + !

  :INIT_MSG print
  record MAP_PORT + @ .
  record MAP_PATH + @ print
  " current=" print current .
  " min=" print minim .
  " max=" print maxim . cr
;

# ( record current -- difference_in_midi_steps )
: observed_difference { record current }
  record MAP_MAXIMUM + @
  record MAP_MINIMUM + @ -
  abs

  dup 0 =
  if
    drop
    current record MAP_EXPECTED + @ -
    abs
    return
  endif

  current record MAP_EXPECTED + @ -
  abs
  swap /
  127.0 *
;

# ( record current -- )
: update_record { record current }
  # A recently sent MIDI value may not yet have
  # reached Faust when an earlier get was answered.
  clock last_send @ -
  SEND_GRACE <
  if
    return
  endif

  record current observed_difference
  CHANGE_TOLERANCE >
  if
    record MAP_LATCHED + @
    if
      0 record MAP_LATCHED + !

      :UNLATCH_MSG print
      record MAP_PATH + @ print
      " current=" print current . cr
    endif

    # Whether latched or not, use the observed
    # Faust value as the new pickup target.
    current record MAP_CURRENT + !
    current record MAP_EXPECTED + !
  endif
;

# ( path current minim maxim input_port -- )
: initialize_mapping { path current minim maxim input_port }
  input_port path lookup_response

  dup 0 <
  if
    drop
    return
  endif

  # Stack: record
  dup MAP_INITIALIZED + @
  if
    current update_record
  else
    current minim maxim init_record
  endif
;

# ( path current min max input_port -- )
: print_introspection { path current minim maxim input_port }
  "OSC response from input port " print
  input_port . cr

  "  Path: " print
  path print cr

  "  Current/min/max: " print
  current . minim . maxim . cr
;

# ( socket input_port -- )
: poll_response_socket { sock input_port }
  sock osc_rx_sock !

  osc_synth_recv
  if
    input_port initialize_mapping
  endif
;

: poll_responses
  rx_count @ 0 1 for
    rx_socks i + @
    rx_ports i + @
    poll_response_socket
  next
;

# ( record_address -- target )
: mapping_target { record }
  record MAP_CURRENT + @
  record MAP_MINIMUM + @ -
  record MAP_MAXIMUM + @
  record MAP_MINIMUM + @ -
  /
  127.0 *
;

# ( record_address midi_value -- )
: send_mapping { record midi_value }
  record MAP_MINIMUM + @
  midi_value 127.0 /
  record MAP_MAXIMUM + @
  record MAP_MINIMUM + @ -
  *
  +

  # Stack: scaled OSC value
  #
  # Update our expected value before transmission.
  dup record MAP_EXPECTED + !
  dup record MAP_CURRENT + !

  :SEND_MSG print
  record MAP_PATH + @ print
  :VALUE_EQ print dup . cr

  # Start the stale-response grace period.
  clock last_send !

  record MAP_PORT + @
  record MAP_PATH + @
  rot

  send_scaled_osc
;

# ( record_address midi_value -- )
: process_mapping { record midi_value }
  record MAP_INITIALIZED + @ 0 =
  if
    :WAIT_MSG print
    record MAP_PATH + @ print
    :AWAITING_INTROSPECTION print cr
    return
  endif

  record MAP_LATCHED + @ 0 =
  if
    midi_value record mapping_target - abs
    PICKUP_TOLERANCE <=
    if
      1 record MAP_LATCHED + !

      :LATCH_MSG print
      record MAP_PATH + @ print
      :CC_EQ print
      midi_value . cr
    else
      :WAIT_MSG print
      record MAP_PATH + @ print
      :CC_EQ print midi_value .
      :TARGET_EQ print record mapping_target . cr
      return
    endif
  endif

  record midi_value send_mapping
;

# ( channel cc value -- )
: dispatch_cc { channel cc value }
  channel cc lookup_mapping

  dup 0 <
  if
    drop
    return
  endif

  value process_mapping
;

: poll_midi
  midi_cc_event
  if
    dispatch_cc
  endif
;

# ( -- )
: poll_due
  clock last_poll @ -
  POLL_INTERVAL >=
  if
    request_all
    clock last_poll !
  endif
;

: run
  "MIDI->OSC routing running..." print cr

  inf times
    poll_midi
    poll_responses
    poll_due
    0.001 sleep
  again
;

# Mapping records are appended after this point.
here mapping_base !

load_config

:OSC_HOST 5530 osc_connect
0 current_osc_port !

init_response_sockets
request_all

clock last_poll !
0 last_send !

run
