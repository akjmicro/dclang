##################################################
# Config-driven MIDI -> OSC bridge for Faust.    #
#                                                #
# Features:                                      #
#   - Configurable MIDI CC -> OSC mappings       #
#   - Startup discovery of OSC endpoints         #
#   - Ignore unavailable synths                  #
#   - Faust parameter introspection              #
#   - MIDI soft takeover                         #
#   - External OSC change detection              #
#   - 500 ms polling of active synths only       #
#                                                #
# Mappings: midi_to_osc.conf                     #
##################################################

"midi.dc" import
"osc.dc"  import

"midi_to_osc.conf"   const :CONFIG_FILE
"r"                  const :READ_MODE
" \t\r"              const :FIELDS
"\n"                 const :NEWLINE
":"                  const :COLON
",f"                 const :OSC_FLOAT_TYPE

"Missing controller" const :MISSING_CONTROLLER
"Missing host"       const :MISSING_HOST
"Missing port"       const :MISSING_PORT
"Missing OSC path"   const :MISSING_OSC_PATH

"[INIT] "            const :INIT_MSG
"[WAIT] "            const :WAIT_MSG
"[LATCH] "           const :LATCH_MSG
"[UNLATCH] "         const :UNLATCH_MSG
"[SEND] "            const :SEND_MSG
"[ONLINE] "          const :ONLINE_MSG
"[WARNING] No OSC response from "
                     const :OFFLINE_MSG
"; ignoring mappings" const :IGNORING_MSG

" value="            const :VALUE_EQ
"Mapped: "           const :MAPPED
" CC="               const :CC_EQ
" target="           const :TARGET_EQ

"Duplicate MIDI mapping: "
                     const :DUPLICATE_MIDI_MAPPING
"Invalid MIDI channel/controller"
                     const :INVALID_MIDI_CHAN
"Invalid OSC port"   const :INVALID_OSC_PORT
"OSC command port already assigned to another host: "
                     const :DUPLICATE_RESPONSE_PORT

16                   const MAX_OSC_RECEIVERS
2.0                  const PICKUP_TOLERANCE

0.5                  const POLL_INTERVAL
0.15                 const SEND_GRACE
0.5                  const CHANGE_TOLERANCE

# Startup discovery duration in milliseconds.
500                  const DISCOVERY_MS

# Mapping record offsets.
0 const MAP_CHANNEL
1 const MAP_CC
2 const MAP_HOST
3 const MAP_PORT
4 const MAP_PATH
5 const MAP_CURRENT
6 const MAP_MINIMUM
7 const MAP_MAXIMUM
8 const MAP_INITIALIZED
9 const MAP_LATCHED
10 const MAP_EXPECTED

11 const MAP_RECORD_SIZE

tmake const MIDI_TREE

var mapping_count
0 mapping_count !

var mapping_base

var current_midi_channel
0 current_midi_channel !

# Endpoint arrays. Each index describes one
# unique OSC command port.
var rx_count
0 rx_count !

var rx_hosts  MAX_OSC_RECEIVERS allot
var rx_ports  MAX_OSC_RECEIVERS allot
var rx_socks  MAX_OSC_RECEIVERS allot
var rx_active MAX_OSC_RECEIVERS allot
var rx_paths  MAX_OSC_RECEIVERS allot
var tx_socks  MAX_OSC_RECEIVERS allot

var config_buf
var line_save
var line_ptr
var field_save

var last_poll
var last_send

64 mkbuf const :KEY_BUF

##################################################
# Mapping storage and lookup
##################################################

# ( one_based_index -- record_address )
: mapping_record { idx }
  mapping_base @
  idx 1 - MAP_RECORD_SIZE * +
;

# ( channel cc -- key )
: make_key { channel cc }
  :KEY_BUF 0 64 memset drop

  mark
  :KEY_BUF
    channel tostr str+
    :COLON str+
    cc tostr str+
  drop
  rewind

  :KEY_BUF
;

# ( channel cc host port path -- )
: store_mapping { channel cc host port path }
  channel ,
  cc ,
  host ,
  port ,
  path ,
  0 ,  # current
  0 ,  # minimum
  0 ,  # maximum
  0 ,  # initialized
  0 ,  # latched
  0 ,  # expected
;

# ( channel cc host port path -- )
: add_mapping { channel cc host port path }
  MIDI_TREE channel cc make_key t@
  if
    :DUPLICATE_MIDI_MAPPING print
    channel cc make_key print cr
    return
  endif

  channel cc host port path store_mapping

  MIDI_TREE
  channel cc make_key
  mapping_count @ 1 +
  t! drop

  :MAPPED print
  channel . cc . host print " " print port . path print cr

  mapping_count inc!
;

# ( channel cc host port path -- )
: validate_mapping { channel cc host port path }
  channel 1 < channel 16 > or
  cc 0 < cc 127 > or
  or
  if
    :INVALID_MIDI_CHAN print cr
    return
  endif

  port 1 < port 65535 > or
  if
    :INVALID_OSC_PORT print cr
    return
  endif

  channel cc host port path  add_mapping
;

# ( channel-str cc-str host-str port-str path -- )
: parse_mapping_fields { channel cc host port path }
  channel tonum
  cc tonum
  host
  port tonum
  path
  validate_mapping
;

##################################################
# Configuration parsing
##################################################

# ( line -- )
: parse_line { line }
  line :FIELDS field_save strtok

  dup 0 =
  if
    drop
    return
  endif

  # Ignore comment lines.
  dup ord 35 =
  if
    drop
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    2drop
    :MISSING_CONTROLLER print cr
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    drop 2drop
    :MISSING_HOST print cr
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    2drop 2drop
    :MISSING_PORT print cr
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    2drop 2drop drop
    :MISSING_OSC_PATH print cr
    return
  endif

  parse_mapping_fields
;

# Iterative parser: no recursive call per line.
: parse_config
  config_buf @ :NEWLINE line_save strtok
  line_ptr !

  2048 0 1 for
    line_ptr @ 0 =
    if
      return
    endif
    line_ptr @ parse_line
    null :NEWLINE line_save strtok
    line_ptr !
  next
;

: load_config
  :CONFIG_FILE :READ_MODE fopen

  dup 0 =
  if
    drop
    "Cannot open configuration file" print cr
    return
  endif

  dup freadall
  drop
  config_buf !
  fclose

  parse_config

  "Loaded mappings: " print
  mapping_count @ . cr
;

# ( channel cc -- record_address | -1 )
: lookup_mapping { channel cc }
  MIDI_TREE channel cc make_key t@

  dup 0 =
  if
    drop
    -1
  else
    mapping_record
  endif
;

##################################################
# OSC endpoint registry
##################################################

# ( host port idx -- index | -1 )
: find_endpoint_from { host port idx }
  idx rx_count @ >=
  if
    -1
    return
  endif

  host rx_hosts idx +@ str=
    port rx_ports idx +@ =
  and
  if
    idx
  else
    host port idx inc find_endpoint_from
  endif
;

# ( host port -- index | -1 )
: find_endpoint { host port }
  host port 0 find_endpoint_from
;

# A response receiver binds locally to command
# port + 1. Two remote hosts therefore cannot
# share one command port in the same bridge.
# ( port idx -- index | -1 )
: find_response_port_from { port idx }
  idx rx_count @ >=
  if
    -1
    return
  endif

  port rx_ports idx +@ =
  if
    idx
  else
    port idx inc find_response_port_from
  endif
;

# ( host port -- flag )
: endpoint_active { host port }
  host port find_endpoint

  dup 0 <
  if
    drop
    0
    return
  endif

  rx_active swap +@
;

# ( host port -- )
: mark_endpoint_active { host port }
  host port find_endpoint

  dup 0 <
  if
    drop
    return
  endif

  rx_active + 1 swap !
;

# ( host port path -- )
: add_response_socket { host port path }
  host port find_endpoint 0 >=
  if
    return
  endif

  port 0 find_response_port_from 0 >=
  if
    :DUPLICATE_RESPONSE_PORT print
    port . cr
    return
  endif

  rx_count @ MAX_OSC_RECEIVERS >=
  if
    "Too many OSC receivers!" print cr
    return
  endif

  # Faust responds on command port + 1.
  port 1 + osc_listen

  host port osc_connect

  host          rx_hosts  rx_count @ + !
  port          rx_ports  rx_count @ + !
  osc_rx_sock @ rx_socks  rx_count @ + !
  osc_sock @    tx_socks  rx_count @ + !
  0             rx_active rx_count @ + !
  path          rx_paths  rx_count @ + !

  rx_count inc!
;

# ( host port -- )
: select_osc_host_and_port { host port }
  host port find_endpoint
  dup 0 <
  if
    drop
    return
  endif
  tx_socks swap +@ osc_sock !
;

##################################################
# OSC sending
##################################################

# ( host port path scaled_value -- )
: send_scaled_osc { host port path scaled_value }
  host port  select_osc_host_and_port
  path :OSC_FLOAT_TYPE osc_message
  scaled_value osc_f
  osc_send
;

# ( record_address -- )
: request_mapping { record }
  record MAP_HOST +@
    record MAP_PORT +@
  select_osc_host_and_port
  record MAP_PATH +@ osc_synth_get
;

# ( -- )
: init_response_sockets
  mapping_count @ 0 1 for
    i 1 + mapping_record  # ( record )
    dup MAP_HOST +@       # ( record host )
    swap dup MAP_PORT +@  # ( host record port )
    swap MAP_PATH +@      # ( host port path )
    add_response_socket
  next

  "OSC endpoints configured: " print
  rx_count @ . cr
;

##################################################
# Response lookup and introspection
##################################################

# ( input_host input_port path idx -- record | -1 )
: lookup_response_from { input_host input_port path idx }
  idx mapping_count @ >=
  if
    -1
    return
  endif

  idx 1 + mapping_record              # ( record )

  dup MAP_HOST +@ input_host str=     # ( record host= )
    over MAP_PORT +@ input_port =     # ( record host= port= )
  and                                 # ( record host+port= )
    over MAP_PATH +@ path str=        # ( record host+port= path= )
  and                                 # ( record all= )
  if
    # Return record address.
  else
    drop
    input_host input_port path idx inc   lookup_response_from
  endif
;

# ( input_host input_port path -- record | -1 )
: lookup_response { input_host input_port path }
  input_host input_port path 0 lookup_response_from
;

# ( record current minim maxim -- )
: init_record { record current minim maxim }
  current record MAP_CURRENT + !
  minim record MAP_MINIMUM + !
  maxim record MAP_MAXIMUM + !
  current record MAP_EXPECTED + !
  0 record MAP_LATCHED + !
  1 record MAP_INITIALIZED + !

  :INIT_MSG print
  record MAP_HOST +@ print " " print
  record MAP_PORT +@ .
  record MAP_PATH +@ print
  " current=" print current f.
  " min=" print minim f.
  " max=" print maxim f. cr
;

# ( record current -- difference_in_midi_steps )
: observed_difference { record current }
  record MAP_MAXIMUM + @
  record MAP_MINIMUM + @ f-
  fabs

  dup 0.0 f=
  if
    drop
    current record MAP_EXPECTED + @ f-
    fabs
    return
  endif

  current record MAP_EXPECTED + @ f-
  fabs
  swap f/
  127.0 f*
;

# ( record current -- )
: update_record { record current }
  monoclock last_send @ f-
  SEND_GRACE f<
  if
    return
  endif

  record current observed_difference
  CHANGE_TOLERANCE f>
  if
    record MAP_LATCHED + @
    if
      0 record MAP_LATCHED + !

      :UNLATCH_MSG print
      record MAP_PATH + @ print
      " current=" print current f. cr
    endif

    current record MAP_CURRENT + !
    current record MAP_EXPECTED + !
  endif
;

# ( path current minim maxim input_host input_port -- )
: initialize_mapping { path current minim maxim input_host input_port }
  # Any valid introspection response establishes
  # that the endpoint is available.
  input_host input_port         mark_endpoint_active

  input_host input_port path    lookup_response

  dup 0 <
  if
    drop
    return
  endif

  dup MAP_INITIALIZED + @
  if
    current update_record
  else
    current minim maxim init_record
  endif
;

# ( socket input_host input_port -- )
: poll_response_socket { sock input_host input_port }
  sock osc_rx_sock !

  osc_synth_recv
  if
    input_host input_port initialize_mapping
  endif
;

# Poll every discovery socket. This is used
# only during the startup discovery window.
: poll_discovery_responses
  rx_count @ 0 1 for
    rx_socks i +@
    rx_hosts i +@
    rx_ports i +@
    poll_response_socket
  next
;

# Poll only confirmed active endpoints.
: poll_responses
  rx_count @ 0 1 for
    rx_active i +@
    if
      rx_socks i +@
      rx_hosts i +@
      rx_ports i +@
      poll_response_socket
    endif
  next
;

##################################################
# Startup discovery
##################################################

# Send exactly one introspection request
# per unique OSC command port.
: probe_endpoints
  rx_count @ 0 1 for
    rx_hosts i +@
      rx_ports i +@
    select_osc_host_and_port
    rx_paths i +@ osc_synth_get
  next
;

# Wait for startup responses, then freeze
# the active endpoint set.
: discover_endpoints
  "Discovering OSC endpoints..." print cr

  probe_endpoints

  DISCOVERY_MS 0 1 for
    poll_discovery_responses
    0.001 sleep
  next

  "OSC discovery results:" print cr

  rx_count @ 0 1 for
    rx_active i +@
    if
      :ONLINE_MSG print
      rx_hosts i +@ print " " print
      rx_ports i +@ . cr
    else
      :OFFLINE_MSG print
      rx_hosts i +@ print " " print
      rx_ports i +@ .
      :IGNORING_MSG print cr
    endif
  next
;

##################################################
# Runtime introspection
##################################################

# Send get requests only to active endpoints.
: request_all
  mapping_count @ 0 1 for
    i 1 + mapping_record
    dup  MAP_HOST +@
      over MAP_PORT +@
    endpoint_active
    if
      request_mapping
    else
      drop
    endif
  next
;

##################################################
# MIDI soft takeover
##################################################

# ( record_address -- target )
: mapping_target { record }
  record MAP_CURRENT + @
  record MAP_MINIMUM + @ f-
  record MAP_MAXIMUM + @
  record MAP_MINIMUM + @ f-
  f/
  127.0 f*
;

# ( record_address midi_value -- )
: send_mapping { record midi_value }
  # Arrange the final send arguments first so
  # no Forth-style rot word is needed.
  record MAP_HOST +@
  record MAP_PORT +@
  record MAP_PATH +@

  record MAP_MINIMUM +@
  midi_value i>f 127.0 f/
  record MAP_MAXIMUM +@
  record MAP_MINIMUM +@ f-
  f*
  f+

  dup record MAP_EXPECTED + !
  dup record MAP_CURRENT + !

  :SEND_MSG print
  record MAP_PATH +@ print
  :VALUE_EQ print dup f. cr

  monoclock last_send !
  send_scaled_osc
;

# ( record_address midi_value -- )
: process_mapping { record midi_value }
  # Ignore mappings belonging to unavailable
  # endpoints, without logging or sending.
  record
    dup MAP_HOST +@
  swap MAP_PORT +@
  endpoint_active 0 =
  if
    return
  endif

  # Also ignore parameters that have not yet
  # returned valid introspection.
  record MAP_INITIALIZED + @ 0 =
  if
    return
  endif

  record MAP_LATCHED + @ 0 =
  if
    midi_value i>f record mapping_target f- fabs
    PICKUP_TOLERANCE f<=
    if
      1 record MAP_LATCHED + !

      :LATCH_MSG print
      record MAP_PATH + @ print
      :CC_EQ print
      midi_value . cr
    else
      :WAIT_MSG print
      record MAP_PATH + @ print
      :CC_EQ print midi_value .
      :TARGET_EQ print record mapping_target f. cr
      return
    endif
  endif

  record midi_value send_mapping
;

: clear_latches
  mapping_count @ 0 1 for
    i 1 + mapping_record
    MAP_LATCHED + 0 swap !
  next
;

# ( channel cc value -- )
: dispatch_cc { channel cc value }

  # clear latches if we've changed channels
  channel current_midi_channel @ <>
  if
    clear_latches
    channel current_midi_channel !
  endif

  channel cc lookup_mapping

  dup 0 <
  if
    drop
    return
  endif

  value process_mapping
;

: poll_midi
  midi_cc_event
  if
    dispatch_cc
  endif
;

##################################################
# Main loop
##################################################

: poll_due
  monoclock last_poll @ f-
  POLL_INTERVAL f>=
  if
    request_all
    monoclock last_poll !
  endif
;

: _routing_loop
  poll_midi
  poll_responses
  poll_due
  0.001 sleep
  _routing_loop
;

: run
  "MIDI->OSC routing running..." print cr
  _routing_loop
;

##################################################
# Initialization
##################################################

# Mapping records are appended after this point.
here mapping_base !

load_config

# Create temporary discovery receivers.
init_response_sockets

# Probe once, classify endpoints, and exclude
# unavailable synths from runtime operations.
discover_endpoints

# Initialize remaining parameters of active synths.
request_all

monoclock last_poll !
0 last_send !

run
