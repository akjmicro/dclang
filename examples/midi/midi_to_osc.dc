##################################################
# A complete, config-driven solution for mapping #
# MIDI chan/controller message to arbitrary OSC  #
# ports and paths, for instance: Faust synths.   #
#                                                #
# Mappings are declared in `midi_to_osc.conf`.   #
##################################################

"midi.dc" import
"osc.dc"  import

"midi_to_osc.conf"   const :CONFIG_FILE
"r"                  const :READ_MODE
" \t\r"              const :FIELDS
"\n"                 const :NEWLINE
":"                  const :COLON
"m2o:"               const :PREFIX
"127.0.0.1"          const :OSC_HOST
",f"                 const :OSC_FLOAT_TYPE
"Missing controller" const :MISSING_CONTROLLER
"Missing port"       const :MISSING_PORT
"Missing OSC path"   const :MISSING_OSC_PATH
"[INIT] "            const :INIT_MSG
"[WAIT] "            const :WAIT_MSG
"[LATCH] "           const :LATCH_MSG
"[SEND] "            const :SEND_MSG
" value="            const :VALUE_EQ
"Mapped: "           const :MAPPED
" CC="               const :CC_EQ
" target="           const :TARGET_EQ
"Too many mappings!" const :TOO_MANY_MAPPINGS
"Duplicate MIDI mapping: "
                     const :DUPLICATE_MIDI_MAPPING
"Invalid MIDI channel/controller"
                     const :INVALID_MIDI_CHAN
"Invalid OSC port"   const :INVALID_OSC_PORT
" awaiting introspection"
                     const :AWAITING_INTROSPECTION
5520                 const TEST_OSC_PORT
2048                 const MAX_MAPPINGS
16                   const MAX_OSC_RECEIVERS
2                    const PICKUP_TOLERANCE

var mapping_count
0 mapping_count !

var rx_count
0 rx_count !
var rx_ports MAX_OSC_RECEIVERS allot
var rx_socks MAX_OSC_RECEIVERS allot

var map_channels     MAX_MAPPINGS allot
var map_ccs          MAX_MAPPINGS allot
var map_ports        MAX_MAPPINGS allot
var map_paths        MAX_MAPPINGS allot
var map_current      MAX_MAPPINGS allot
var map_minimum      MAX_MAPPINGS allot
var map_maximum      MAX_MAPPINGS allot
var map_initialized  MAX_MAPPINGS allot
var map_latched      MAX_MAPPINGS allot
var config_buf
var line_save
var field_save
var current_osc_port

64 mkbuf const :KEY_BUF

# ( channel cc -- key )
: make_key { channel cc }
  :KEY_BUF 0 64 memset drop

  :KEY_BUF
    :PREFIX str+
    channel tostr str+
    :COLON str+
    cc tostr str+
  drop

  :KEY_BUF
;

# ( channel cc port path idx -- )
: store_mapping { channel cc port path idx }
  channel map_channels    idx + !
  cc      map_ccs         idx + !
  port    map_ports       idx + !
  path    map_paths       idx + !
  0       map_initialized idx + !
  0       map_latched     idx + !
;

# ( channel cc port path -- )
: add_mapping { channel cc port path }
  mapping_count @ MAX_MAPPINGS >=
  if
    :TOO_MANY_MAPPINGS print cr
    return
  endif

  channel cc make_key h@
  if
    :DUPLICATE_MIDI_MAPPING print
    channel cc make_key print cr
    return
  endif

  channel cc port path mapping_count @ store_mapping

  # Hash value is a persistent, one-based index string.
  mapping_count @ 1 + tostr strdup
  channel cc make_key h!

  :MAPPED print
  channel . cc . port .
  path print cr

  mapping_count @ 1 + mapping_count !
;

# ( channel cc port path -- )
: validate_mapping { channel cc port path }
  channel 1 < channel 16 > or
  cc 0 < cc 127 > or
  or
  if
    :INVALID_MIDI_CHAN print cr
    return
  endif

  port 1 < port 65535 > or
  if
    :INVALID_OSC_PORT print cr
    return
  endif

  channel cc port path add_mapping
;

# ( channel-str cc-str port-str path -- )
: parse_mapping_fields { channel cc port path }
  channel tonum
  cc tonum
  port tonum
  path
  validate_mapping
;

# ( line -- )
: parse_line { line }
  line :FIELDS field_save strtok

  dup 0 =
  if
    drop
    return
  endif

  # Ignore comment lines.
  dup ord 35 =
  if
    drop
    return
  endif

  # First token (channel) remains on stack.

  null :FIELDS field_save strtok
  dup 0 =
  if
    2drop
    :MISSING_CONTROLLER print cr
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    drop 2drop
    :MISSING_PORT print cr
    return
  endif

  null :FIELDS field_save strtok
  dup 0 =
  if
    drop 2drop drop
    :MISSING_OSC_PATH print cr
    return
  endif

  # Stack: channel cc port path
  parse_mapping_fields
;

# ( line -- )
: parse_config_line { line }
  line 0 <>
  if
    line parse_line
    null :NEWLINE line_save strtok
    parse_config_line
  endif
;

: parse_config
  config_buf @ :NEWLINE line_save strtok
  parse_config_line
;

: load_config
  :CONFIG_FILE :READ_MODE fopen

  dup 0 =
  if
    drop
    "Cannot open configuration file" print cr
    return
  endif

  # freadall: ( file -- file buffer length )
  dup freadall
  drop
  config_buf !
  fclose

  parse_config

  "Loaded mappings: " print
  mapping_count @ . cr
;

# ( channel cc -- index | -1 )
: lookup_mapping { channel cc }
  channel cc make_key h@

  dup 0 =
  if
    drop
    -1
  else
    tonum 1 -
  endif
;

: init_osc
  :OSC_HOST TEST_OSC_PORT osc_connect
  "OSC test socket initialized" print cr
;

# ( port -- )
: select_osc_port { port }
  port current_osc_port @ <>
  if
    osc_sock @ :OSC_HOST port udpconnect drop
    port current_osc_port !
  endif
;

# ( port path midi_value -- )
: send_test_osc { port path midi_value }
  port select_osc_port

  path :OSC_FLOAT_TYPE osc_message
  midi_value 127.0 / osc_f
  osc_send
;

# ( port path scaled_value -- )
: send_scaled_osc { port path scaled_value }
  port select_osc_port
  path :OSC_FLOAT_TYPE osc_message
  scaled_value osc_f
  osc_send
;

# ( idx -- )
: request_mapping { idx }
  # DEBUG
  "Requesting: " print
  map_ports idx + @ .
  map_paths idx + @ print cr
  # END DEBUG

  map_ports idx + @ select_osc_port
  map_paths idx + @ osc_synth_get
;

# ( -- )
: request_all
  mapping_count @ 0 1
  for
    i request_mapping
  next
;

# ( port idx -- flag )
: rx_port_exists_from { port idx }
  idx rx_count @ >=
  if
    0
    return
  endif

  port rx_ports idx + @ =
  if
    1
  else
    port idx 1 + rx_port_exists_from
  endif
;

# ( port -- )
: add_response_socket { port }
  port 0 rx_port_exists_from
  if
    return
  endif

  rx_count @ MAX_OSC_RECEIVERS >=
  if
    "Too many OSC receivers!" print cr
    return
  endif

  # Response port is command port + 1.
  port 1 + osc_listen

  port          rx_ports rx_count @ + !
  osc_rx_sock @ rx_socks rx_count @ + !

  rx_count @ 1 + rx_count !
;

# ( -- )
: init_response_sockets
  mapping_count @ 0 1 for
    map_ports i + @ add_response_socket
  next

  "OSC receivers initialized: " print
  rx_count @ . cr
;

# ( input_port path idx -- index | -1 )
: lookup_response_from { input_port path idx }
  idx mapping_count @ >=
  if
    -1
    return
  endif

  input_port map_ports idx + @ =
  path map_paths idx + @ str=
  and
  if
    idx
  else
    input_port path idx 1 + lookup_response_from
  endif
;

# ( input_port path -- index | -1 )
: lookup_response { input_port path }
  input_port path 0 lookup_response_from
;

# ( path current minim maxim input_port -- )
: initialize_mapping { path current minim maxim input_port }
  input_port path lookup_response

  dup 0 <
  if
    drop
    return
  endif

  # Stack: mapping index
  dup map_initialized + @
  if
    drop
    return
  endif

  dup map_current + current swap !
  dup map_minimum + minim swap !
  dup map_maximum + maxim swap !
  dup map_latched + 0 swap !
  dup map_initialized + 1 swap !

  :INIT_MSG print
  dup map_ports + @ .
  dup map_paths + @ print
  " current=" print current .
  " min=" print minim .
  " max=" print maxim . cr

  drop
;

# ( path current min max input_port -- )
: print_introspection { path current minim maxim input_port }
  "OSC response from input port " print
  input_port . cr

  "  Path: " print
  path print cr

  "  Current/min/max: " print
  current . minim . maxim . cr
;

# ( socket input_port -- )
: poll_response_socket { sock input_port }
  sock osc_rx_sock !

  osc_synth_recv
  if
    # for debugging only:
    # 2over  2over
    # input_port print_introspection
    input_port initialize_mapping
  endif
;

: poll_responses
  rx_count @ 0 1 for
    rx_socks i + @
    rx_ports i + @
    poll_response_socket
  next
;

# ( index -- target )
: mapping_target { idx }
  map_current idx + @
  map_minimum idx + @ -
  map_maximum idx + @
  map_minimum idx + @ -
  /
  127.0 *
;

# ( index midi_value -- )
: send_mapping { idx midi_value }
  map_minimum idx + @
  midi_value 127.0 /
  map_maximum idx + @
  map_minimum idx + @ -
  *
  +

  # Stack: scaled OSC value
  :SEND_MSG print
  idx map_paths + @ print
  :VALUE_EQ print dup . cr

  idx map_ports + @
  idx map_paths + @
  rot
  # Stack: port path scaled_value

  # Send the already-scaled value directly.
  send_scaled_osc
;

# ( index midi_value -- )
: process_mapping { idx midi_value }
  idx map_initialized + @ 0 =
  if
    :WAIT_MSG print
    idx map_paths + @ print
    :AWAITING_INTROSPECTION print cr
    return
  endif

  idx map_latched + @ 0 =
  if
    midi_value idx mapping_target - abs
    PICKUP_TOLERANCE <=
    if
      1 map_latched idx + !

      :LATCH_MSG print
      idx map_paths + @ print
      :CC_EQ print
      midi_value . cr
    else
      :WAIT_MSG print
      idx map_paths + @ print
      :CC_EQ print midi_value .
      :TARGET_EQ print idx mapping_target . cr
      return
    endif
  endif

  idx midi_value send_mapping
;

# ( channel cc value -- )
: dispatch_cc { channel cc value }
  channel cc lookup_mapping
  dup 0 <
  if
    drop
    return
  endif
  value process_mapping
;

: poll_midi
  midi_cc_event
  if
    dispatch_cc
  endif
;

: run
  "MIDI->OSC routing running..." print cr
  inf times
    poll_midi
    poll_responses
    0.001 sleep
  again
;

load_config
:OSC_HOST 5530 osc_connect
0 current_osc_port !
init_response_sockets
request_all
run
