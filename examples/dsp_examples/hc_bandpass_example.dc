"dsp.dc" import

make_hc_filter mylp1
make_hc_filter mylp2
make_hc_filter mylp3
make_hc_filter mylp4

var modwave
var res
var slmem

: render_frame
    # sweeping mod
    # do from 0.08 - 0.02
    0.2 sine 200.0 f* 600.0 f+
    modwave !
    0.1 res !
    ### LEFT ###
    247.0 phasor 2.0 f* 1.0 f- 0.5 f*
    mylp1 modwave @ res @ hc_bandpass
    mylp2 modwave @ res @ hc_bandpass 0.1 f*
    # panning
    0.1 panmix
    ### RIGHT ###
    247.31252 phasor 2.0 f* 1.0 f- 0.5 f*
    mylp3 modwave @ res @ hc_bandpass
    mylp4 modwave @ res @ hc_bandpass 0.4 f*
    # panning
    0.9 panmix
    # output
  lcget rcget
  t+
;

: hc_bandpass_example
  render_frame stereo_out
  hc_bandpass_example
;
