"dsp.dc" import

# create a delay line
1 make_delay_line mydelay

var myport
0.02 tau_to_alpha const :ATT
0.35 tau_to_alpha const :REL

# example function
: render_frame
  440 sine
  0.4333 metro 0.8 *
  myport :ATT :REL port *
  mydelay 0.4462 delay_read 0.75 *
  2dup +
  mydelay delay_write
  0.5 * +
  0.5 panmix
  lcget rcget
  t+
;

: simple_delay_example
  inf times
    render_frame _stereo_out32
  again
;
