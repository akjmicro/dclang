"dsp.dc" import

make_hc_filter mylp

: render_frame
    #############
    # top pitch #
    #############
    0.1 sine     # sine modulation of phase
    0.5 f* 0.5 f+  # bring within 0-1 range
    0.8 f* 0.1 f+  # squash
      120.0      # pitch of pulse
    pulse 0.8 f*
    mylp 800.0 0.1 hc_lowpass 0.17 f*
    # mix and output
    0.15 panmix
    ################
    # bottom pitch #
    ################
    0.15 sine    # sine modulation of phase
    0.5 f* 0.5 f+  # bring within 0-1 range
    0.8 f* 0.1 f+  # squash
      80.1       # pitch of pulse
    pulse 0.8 f*
    mylp 800.0 0.1 hc_lowpass 0.17 f*
    # mix and output
    0.85 panmix
    ##########
    # output #
    ##########
  lcget rcget
  t+
;

: pw_mod_example
  render_frame stereo_out
  pw_mod_example
;
