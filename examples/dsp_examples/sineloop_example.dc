"dsp.dc" import
"midi.dc" import

var sl1
var sl2
var modwave
make_hc_filter mylp
make_hc_filter mylp2

: render_frame
  t 0x8f and 0 = if
      refresh_midictl
  endif
    0.1 21 midictl 127.0 f/ 6.0 f* f+
    sine
  0.5 f* 0.5 f+ 1.284 f* modwave !
  sl1 200.0 modwave @ sineloop 0.53 f*
  0.02 panmix
  sl2 300.0 modwave @ sineloop 0.53 f*
  0.98 panmix
  lcget rcget
  t+
;

: sineloop_example
  render_frame stereo_out
  sineloop_example
;
