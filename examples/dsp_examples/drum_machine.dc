"dsp.dc" import

############################
# Make a 32-step sequencer #
############################
var top_bit       1 31 << top_bit !
############################################################
# A variable to track which bit in the sequence we are on. #
# As the sequence progresses, the bit slot gets smaller    #
# by a factor of two, i.e. 1024, 512, 256, 128, ....       #
############################################################
var seq_bit       top_bit @ seq_bit !

#################
# Set the tempo #
#################
var tempo  2.0 tempo !

###############
# Drum Volume #
###############
var drum_vol 0.8 drum_vol !

###########################
# Bit patterns for beats! #
###########################
var op_hihat
var cl_hihat
var snare_drum
var bass_drum
0x00020002 op_hihat !
0x41413513 cl_hihat !
0x0808080c snare_drum !
0x80818082 bass_drum !

##################################
# Masking volumes for each sound #
##################################
var   op_hihat_mask
var   cl_hihat_mask
var snare_drum_mask
var  bass_drum_mask

##########################################
# Holding places for the trigger state   #
# Allows us to detect upward signal edge #
##########################################
var curtrig
var lasttrig

########################
# Portamento envelopes #
########################
var op_hihat_port
var cl_hihat_port
var snare_drum_port
var bass_drum_port
0.001 tau_to_alpha const :ATT
0.060 tau_to_alpha const :REL1
0.180 tau_to_alpha const :REL2

##########################################
# Hal Chamberlain filters for the hihats #
##########################################
make_hc_filter  cl_hihat_flt
make_hc_filter  op_hihat_flt

#############################################################
# `_next_bit` r-shifts which bit in the hexbeat to inspect  #
# Also, conditionally resets back to the top bit if it      #
# reaches the right most extreme (typically 0, but we could #
# do different meters by resetting earlier)                 #
#############################################################
: _next_bit
  seq_bit @ 1 >> dup
  0 = if
    drop
    top_bit @ seq_bit !
  else
    seq_bit !
  endif
;

################################################################
# `_bit_on?` answers the question if the bit we are looking at #
# is "on" (or off) for the instrument line given on the stack  #
################################################################
: _bit_on? { this_var }
  seq_bit @
    dup
      this_var @
    and
  = abs
;

# One bounded stereo frame. dclang2c-dsp exposes tempo, drum_vol, and the four
# pattern variables as block-rate controls to the Bela wrapper.
: render_frame
    tempo @ metro    curtrig !
    curtrig @ lasttrig @ f> if
      bass_drum  _bit_on?   bass_drum_mask !
      snare_drum _bit_on?  snare_drum_mask !
      cl_hihat   _bit_on?    cl_hihat_mask !
      op_hihat   _bit_on?    op_hihat_mask !
      _next_bit
    endif
    ###################
    # bass drum sound #
    ###################
    curtrig @ bass_drum_mask @ i>f f*
      bass_drum_port :ATT :REL1
    port
      dup 90.0 f* 90.0 f+ sine
    f*
    drum_vol @ f*
    0.5 panmix
    ####################
    # snare drum sound #
    ####################
    curtrig @ snare_drum_mask @ i>f f*
      snare_drum_port :ATT :REL1
    port
      noise 0.4 f*
        383.0 sine 0.3 f*
      f+
    f*
    drum_vol @ f*
    0.3 panmix
    ######################
    # closed hihat sound #
    ######################
    curtrig @ cl_hihat_mask @ i>f f*
      cl_hihat_port :ATT :REL1
    port
      noise 0.2 f*
        cl_hihat_flt
          3610.0 0.6
      hc_bandpass
    f*
    drum_vol @ f*
    0.7 panmix
    ####################
    # open hihat sound #
    ####################
    curtrig @ op_hihat_mask @ i>f f*
      op_hihat_port :ATT :REL2
    port
      noise 0.3 f*
        op_hihat_flt
          3800.0 0.7
      hc_bandpass
    f*
    drum_vol @ f*
    0.7 panmix
    ############################
    # output & variable update #
    ############################
    lcget rcget
    curtrig @ lasttrig !
    t+
;

: drum_machine
  render_frame stereo_out
  drum_machine
;
