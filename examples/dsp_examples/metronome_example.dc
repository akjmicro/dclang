"dsp.dc" import

var myport

0.02 tau_to_alpha const :ATT
0.35 tau_to_alpha const :REL

: metronome_example
  inf times
      400 sine
        2.01 metro
        1.2 *
          myport :ATT :REL
        port
      *
        0.4
    panmix
      467 sine
        2.51 metro
        1.2 *
          myport :ATT :REL
        port
      *
        0.3 sine
        0.25 *
        0.5 +
    panmix
      600 sine
        3.01 metro
        1.2 *
          myport :ATT :REL
        port
      *
        0.6
    panmix
    stereo_out
    t+
  again
;

metronome_example
