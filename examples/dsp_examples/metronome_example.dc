"dsp.dc" import

var myport

0.02 tau_to_alpha const :ATT
0.35 tau_to_alpha const :REL

: render_frame
  400.0 sine
        2.01 metro
        1.2 f*
          myport :ATT :REL
        port
      f*
        0.4
    panmix
      467.0 sine
        2.51 metro
        1.2 f*
          myport :ATT :REL
        port
      f*
        0.3 sine
        0.25 f*
        0.5 f+
    panmix
      600.0 sine
        3.01 metro
        1.2 f*
          myport :ATT :REL
        port
      f*
        0.6
    panmix
  lcget rcget
  t+
;

: metronome_example
  render_frame stereo_out
  metronome_example
;
