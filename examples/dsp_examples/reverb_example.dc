"dsp.dc" import

var lpmem1
var myport
0.19 tau_to_alpha const :ATT
0.10 tau_to_alpha const :REL
make_reverb_struct my_reverb

: render_frame
      noise 0.87 f*
        lpmem1 0.37
      lowpass
        0.01 0.34 frand 0.14 f* 0.14 f+ f- gate
          myport :ATT :REL
        port
      f*
      0.5 f*
    0.5 panmix
      lchan @ rchan @
        my_reverb
          0.8 0.97
        reverb
      1.0 panmix
    0.0 panmix
  lcget rcget
  t+
;

: reverb_example
  render_frame stereo_out
  reverb_example
;
