"dsp.dc" import

make_hc_filter mylp
1.0 make_delay_line mydelay

: render_frame
    # trigger, will be nozzled off:
      noise 0.5 f*
        mylp
          768.0
            0.3
      hc_lowpass
      0.9 f*
        0.333
          0.1
        gate
        0.5 f*
      f*
        0.3 phasor
      f*
    # filtered noise fed into a delay line resonator
        mydelay
          1.0 256.0 f/
        delay_read
        0.9999999 f*        # ( dry wet )
      f+                    # ( dry+wet )
        dup                 # ( dry+wet dry+wet )
        0.5 panmix          # ( dry+wet )
    # mix for delay_write
      0.99 f*               # ((dry+wet)*0.95)
        mydelay
    delay_write             # ( )
    # final output
  lcget rcget
  t+
;

: ebow_example
  render_frame stereo_out
  ebow_example
;
