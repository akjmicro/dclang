"dsp.dc" import
"music.dc" import
"sequencer.dc" import

var my_ampport
var my_pitchport
var my_fbport
0.002  tau_to_alpha const :ATT
0.291  tau_to_alpha const :REL
0.005  tau_to_alpha const :PCH_RISE
0.01   tau_to_alpha const :PCH_FALL
0.001  tau_to_alpha const :FB_RISE
0.3    tau_to_alpha const :FB_FALL

var tempo  :BASS_TEMPO get_x_tempo     tempo !
var myvol              get_bass_vol    myvol !
var pitch              get_base_pitch  pitch !
var curtrig
var lasttrig
var sl
var lpmem

create my_iter 16 , 0 ,
               1 , 1 , 1 , 1 ,
               1 , 1 , 1 , 7 8 / ,
               1 , 1 , 1 , 4 3 / ,
               4 3 / , 3 2 / , 3 2 / , 3 4 / ,

: metronome_simple
    0.1 tempo @ gate  curtrig !
    curtrig @ lasttrig @ >
    if
      # check if tempo changed
      :BASS_TEMPO get_x_tempo  dup tempo @ <>
      if tempo ! else drop endif
      # check if vol changed
      get_bass_vol dup myvol @ <>
      if myvol ! else drop endif
      # simple pitch sequence using `iterator`
        get_base_pitch
          my_iter iterator
        *
      pitch !
    endif
    curtrig @
      my_ampport :ATT :REL
    port
      sl
        pitch @
          my_pitchport :PCH_RISE :PCH_FALL
        port
          curtrig @
            my_fbport :FB_RISE :FB_FALL
          port
          0.47 0.05   rand * + *
          0.2  0.0125 rand * + +
      sineloop
    *
    lpmem 0.7 lowpass myvol @ *
  0.5 panmix
  stereo_out
  t+
  curtrig @ lasttrig !
  metronome_simple
;

metronome_simple
