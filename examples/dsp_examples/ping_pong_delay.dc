"dsp.dc" import

3.0 make_delay_line dlyL
3.0 make_delay_line dlyR

261.0 3.0 4.0 f/ f* const :BASE_PITCH
3.5         const :METRO_FREQ
1.2         const :BRIGHT
0.6         const :DELWET
1.0 :DELWET f- const :DELDRY
0.75        const :DELWDT
1.0 :DELWDT f- const :DELWDT_I
0.003 tau_to_alpha
            const :RISE_ALPHA
0.137 tau_to_alpha
            const :FALL_ALPHA

var sl
var env_port
var ampenv
var curtrig
var lasttrig
var pitch_idx  -1 pitch_idx !
var drysig
var ltap
var rtap

# A little Pythagorean 'riff'
create pitches  1.0  1.0 f/ ,
                3.0  2.0 f/ ,
                4.0  3.0 f/ ,
                3.0  2.0 f/ ,
               32.0 27.0 f/ ,
                1.0  1.0 f/ ,
                9.0  8.0 f/ ,
                8.0  9.0 f/ ,
                1.0  1.0 f/ ,
                1.0  1.0 f/ ,
               32.0 27.0 f/ ,
                4.0  3.0 f/ ,
                3.0  4.0 f/ ,
                8.0  9.0 f/ ,
var dummy
var pitches_size  dummy pitches -  pitches_size !

: render_frame
    #######################################
    # simple plucked-ish repeating source #
    #######################################
    # envelope signal
    :METRO_FREQ metro
    dup curtrig !
    env_port :RISE_ALPHA :FALL_ALPHA port
    ampenv !
    # Check if we're on the rising edge of a click
    # If so, update pitch
    curtrig @ lasttrig @ f>
    if
      pitch_idx @ 1 + pitches_size @ %
      pitch_idx !
    endif
    # sineloop sound source
    sl
      pitches pitch_idx @ + @
      :BASE_PITCH f*
        :BRIGHT
    sineloop
    ampenv @ f*
    0.45 f*
    drysig !
    ########################
    # read current echoes  #
    ########################
    dlyL 1.0 :METRO_FREQ f/ 3.0 f* 2.0 f/ delay_read ltap !
    dlyR 1.0 :METRO_FREQ f/ 3.0 f* 2.0 f/ delay_read rtap !
    #################
    # stereo output #
    #################
    drysig @ :DELDRY f* ltap @ :DELWET f* f+
    :DELWDT_I panmix   # left out
    drysig @ :DELDRY f* rtap @ :DELWET f* f+
    :DELWDT   panmix   # right out
    lcget rcget
    #############################################
    # cross-feedback:                           #
    # left gets dry injection + feedback from R #
    # right gets feedback from L                #
    #############################################
    drysig @ 0.5 f*  rtap @ 0.5 f* f+  dlyL delay_write
    ltap @ 0.6 f*                       dlyR delay_write
    # update trigger state
    curtrig @ lasttrig !
    # Advance the sample clock
    t+
;

: ping_pong_delay
  render_frame stereo_out
  ping_pong_delay
;
