"dsp.dc" import

# a local constant for 'change_frequency'
0.7575 1.333333 f* const CHANGE_FREQ

# amp envelope stuff:
var env_port
var ampenv
var pitch_port
0.04 tau_to_alpha const :ATT
0.70 tau_to_alpha const :REL
0.02 tau_to_alpha const :PCH_RISE
0.03 tau_to_alpha const :PCH_FALL

# a sineloop variable
var mysl

# filter setup:
make_hc_filter mylp

# delay setup:
1.0 make_delay_line mydelay

# random pitch setup:
# A Wilson CPS hexany (2, 3, 5, 9)
create pitch_choices 0 , 5 , 13 , 18 , 23 , 31 , 36 , 41 ,
var current_pitch    0 current_pitch !
var trigval
var lasttrig
var curtrig
var rntrg

: octfac 31.0 f/ 2.0 swap fpow ;

: render_frame
    # random trigger
    0.01 trigval randtrig dup curtrig !
    # reference array for port and portamento call
    env_port :ATT :REL port
    # route to 'ampenv' variable:
    ampenv !
    # change the pitch variable randomly, in sync with the trigger:
    curtrig @ lasttrig @ f>
    if
      pitch_choices 8 randint + @ current_pitch !
    else
    endif
    # sineloop oscillator:
    mysl
      current_pitch @ i>f octfac 256.0 f*
      pitch_port :PCH_RISE :PCH_FALL port
        ampenv @ 0.89 f* 0.4 f+
    sineloop
    ampenv @ f*
    # boost amplitude
    2.3 f*
    # cut the highs a bit:
    mylp 2750.0 0.3 hc_lowpass
    # osc/filter amplification
    1.8 f*
    mydelay 0.95 delay_read
    # delay amplification
    0.65 f*
    2dup
    0.35 panmix
    0.65 panmix
    # output
    lcget rcget
    # feed the delay feedback!
    f+ 0.5 f* mydelay delay_write
    # update trigger state
    curtrig @ lasttrig !
    # update clock
    t+
;

: delay_example
  render_frame stereo_out
  delay_example
;
