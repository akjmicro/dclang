# Opening this file in the `nano` editor after installing the `contrib/dclang.nanorc` file
# to the correct config location on your system for `nano` should show you some pretty
# syntax coloring!

null false true fpi fe
+ - * / % abs min max << >>
= <> < > <= >=
assert and or not xor
fround fceil ffloor fpow fsqrt fexp flog flog2 flog10 fsin fcos ftan frand
drop dup over pick depth swap rot -rot nip tuck
2drop 2dup 2over 2swap 2rot -2rot 2nip 2tuck
svpush svpop svpick svdrop svclear
! @ const var allot create , h@ h! hkeys
times again exittimes for next exitfor i j k if else endif return
. u. f. h. .. .s f.rj f.pz cr print emit uemit ord tohex bytes32
strlen str= str< str> strfind strtok mempcpy memset mkbuf free
fopen fread fseek ftell fwrite fflush fclose redirect resetout flush
open mkbuf read tcplisten tcpaccept tcpconnect clock monoclock sleep
words primitives import input
: ;

# comment
"string string"

"A string "

"dasd"

" A
long multiline
string!
"

# generic non-primitive defined words are darker green:

: newword
  "hello!" print cr
;
