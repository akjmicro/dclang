: time_add
  "Timing addition:       " print
  monoclock
  25000000 times
    i 42 +
  drop
  again
  monoclock swap f- 2 6 f.rj cr
;

time_add

: time_sub
  "Timing subtraction:    " print
  monoclock
  25000000 times
    i 42 -
  drop
  again
  monoclock swap f- 2 6 f.rj cr
;

time_sub

: time_mul
  "Timing multiplication: " print
  monoclock
  25000000 times
    i 42 *
  drop
  again
  monoclock swap f- 2 6 f.rj cr
;

time_mul

: time_div
  "Timing division:       " print
  monoclock
  25000000 times
    i 42 /
  drop
  again
  monoclock swap f- 2 6 f.rj cr
;

time_div

: time_mod
  "Timing modulus:        " print
  monoclock
  25000000 times
    i 42 %
  drop
  again
  monoclock swap f- 2 6 f.rj cr
;

time_mod

: time_sine
  "Timing sine:           " print
  monoclock
  25000000 times
    i i>f fsin
  drop
  again
  monoclock swap f- 2 6 f.rj cr
;

time_sine
