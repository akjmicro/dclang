"clock_sleep.dc" import

: test_clock_shape
  clock
  { seconds nanoseconds }
  seconds 1700000000 > assert
  nanoseconds 0 >= assert
  nanoseconds 1000000000 < assert
;

: test_clock_arithmetic
  10 900000000 0.2 _clock+
  { seconds nanoseconds }
  seconds 11 = assert
  nanoseconds 100000000 = assert

  10 250000000 1.0 _clock% 0.25 f= assert
;

: test_monoclock
  monoclock
  0.01 sleep
  monoclock swap f-
  0.005 f> assert
;

: test_absolute_sleep
  monoclock svpush
  clock 0.01 _clock+ sleep_until
  monoclock svpop f-
  0.005 f> assert
;

test_clock_shape
test_clock_arithmetic
test_monoclock
test_absolute_sleep
