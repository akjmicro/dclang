create something 456 , 789 ,
something @ 456 = assert
something 1 + @ 789 = assert

: test-create
create 100 , 200 ,
;

test-create creation
creation @ 100 = assert
creation 1 + @ 200 = assert

var foo
var bar

: testvar 20 foo ! 30 bar ! ;

testvar

foo @ 20 = assert
bar @ 30 = assert

: testfuncvar 1 drop var 4 allot ;

testfuncvar alpha
2632.12 alpha !
alpha @ 2632.12 f= assert

testfuncvar beta
1111 beta !
beta @ 1111 = assert

beta alpha - 4 = assert

create arr_to_sort
510 , 83 , 20053 , -19 , 1618 ,
arr_to_sort @ 510 = assert
arr_to_sort 3 + @ -19 = assert
arr_to_sort 5 sortnums
# prove sorting worked:
arr_to_sort @ -19 = assert
arr_to_sort 4 + @ 20053 = assert

# test the newer offset peek/poke primitives
create new_foo_array 0 , 1 , 2 , 3 ,
new_foo_array 1 +@     1 = assert
new_foo_array 2 +@     2 = assert
new_foo_array 3 +@     3 = assert
new_foo_array inc!
new_foo_array @        1 = assert
new_foo_array 0 +@     1 = assert
new_foo_array 3 +inc!
new_foo_array 3 +@     4 = assert
3 new_foo_array 3 +incn!
new_foo_array 3 +@     7 = assert
23 new_foo_array 1 +setn!
new_foo_array 1 +@    23 = assert
