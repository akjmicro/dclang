{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "dclang",
  "scopeName": "source.dclang",
  "patterns": [
    {
      "name": "comment.line.number-sign.dclang",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.dclang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dclang",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.dclang",
      "match": "(?<!\\S)[+-]?(?:0[xX][0-9a-fA-F]+|(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?!\\S)"
    },
    {
      "name": "constant.language.dclang",
      "match": "(?<!\\S)(?:false|null|true|pi|e)(?!\\S)"
    },
    {
      "name": "keyword.operator.dclang",
      "match": "(?<!\\S)(?:assert|atan2|floor|log10|round|acos|asin|atan|ceil|cosh|log2|rand|sinh|sqrt|tanh|abs|and|cos|exp|log|max|min|not|pow|sin|tan|xor|<<|<=|<>|>=|>>|or|%|\\*|\\+|\\-|/|<|=|>)(?!\\S)"
    },
    {
      "name": "support.function.stack.dclang",
      "match": "(?<!\\S)(?:svclear|svdepth|svdrop|svpick|svpush|2drop|2over|clear|depth|svpop|2dup|drop|over|pick|swap|\\.pz|\\.rj|dup|\\.\\.|\\.s|\\.)(?!\\S)"
    },
    {
      "name": "support.function.memory.dclang",
      "match": "(?<!\\S)(?:sortnums|sortstrs|tdestroy|create|envget|envset|allot|const|hkeys|lmake|lpush|lsize|tmake|twalk|here|ldel|lins|lpop|lrem|tdel|var|h!|h@|l!|l@|t!|t@|!|,|@)(?!\\S)"
    },
    {
      "name": "keyword.control.dclang",
      "match": "(?<!\\S)(?:exittimes|exitfor|return|again|endif|times|else|next|for|if|i|j|k)(?!\\S)"
    },
    {
      "name": "support.function.other.dclang",
      "match": "(?<!\\S)(?:unblock_sigint|block_sigint|tcpconnect|udpconnect|dt\\->epoch|epoch\\->dt|freadline|tcpaccept|tcplisten|udpsocket|fmemopen|freadall|redirect|udpclose|mempcpy|memused|strcspn|strfind|tolower|toupper|udpbind|udprecv|udpsend|fclose|fflush|fwrite|memset|rewind|seterr|setout|strlen|strspn|strtok|clock|close|epoch|flush|fopen|fread|fseek|ftell|mkbuf|print|sleep|tohex|tonum|tostr|uemit|write|emit|exit|fork|free|mark|open|read|str<|str=|str>|ord|cr)(?!\\S)"
    },
    {
      "name": "support.function.meta.dclang",
      "match": "(?<!\\S)(?:primitives|constants|variables|import|input|words|exec)(?!\\S)"
    },
    {
      "match": "(?<!\\S)(:)(\\s+)([^\\s]+)",
      "captures": {
        "1": {
          "name": "keyword.declaration.dclang"
        },
        "3": {
          "name": "entity.name.function.dclang"
        }
      }
    },
    {
      "name": "keyword.declaration.dclang",
      "match": "(?<!\\S)(?::|;|\\{|\\})(?!\\S)"
    },
    {
      "name": "constant.other.dclang",
      "match": "(?<!\\S)[_:A-Z0-9]+(?!\\S)"
    },
    {
      "name": "variable.function.dclang",
      "match": "(?<!\\S)[^\\s\"]+(?!\\S)"
    }
  ]
}
