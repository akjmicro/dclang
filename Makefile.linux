CC = gcc
CFLAGS = -w -march=native -O3 -static -finline-functions
LDFLAGS = -lm -lportmidi -lsqlite3
LDDCLANG = -ldclang
OBJECTS = main.o
EXECUTABLE = dclang
LIBOBJ = libdclang.o
LIBSOOBJ = libdclang.so
LIBTESTC = libtest.c
HEADER = dclang.h
PREFIX ?= /usr/local
DSP ?= examples/dsp_examples/simple_delay_example.dc
ENTRY ?= render_frame
SR ?= 44100
BELA_HOST ?= root@192.168.7.2
BELA_HOME ?= /root/Bela
BELA_PROJECT ?= dclang-$(basename $(notdir $(DSP)))
DSP_C ?= /tmp/dclang2c-instrument.c
BELA_CPPFLAGS ?= -Wno-unused-variable -Wno-unknown-pragmas -Wno-tautological-compare

.PHONY: clean lib libtest

default: dclang

%.o: %.c
	$(CC) -c -o $@ $< $(CFLAGS)

dclang: $(OBJECTS)
	$(CC) $(OBJECTS) -o $@ $(LDFLAGS)

dclang2c: dclang2c.c libdclang.c dclang.h dclang_dsp.h dclang_osc.h dclang_fast_math.h dclang_phiverb.h token.c $(wildcard noheap/*)
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

.PHONY: dsp-c bela-build bela-run

dsp-c: dclang2c
	SR=$(SR) DCLANG_LIBS="$(CURDIR)/lib" ./dclang2c "$(DSP)" "$(ENTRY)" "$(DSP_C)"

# Create a standard Bela project containing the generated C and callback.
bela-build: dsp-c
	ssh -o BatchMode=yes $(BELA_HOST) 'mkdir -p "$(BELA_HOME)/projects/$(BELA_PROJECT)"'
	scp -q "$(DSP_C)" examples/dsp_examples/bela_render.cpp dclang_dsp.h dclang_osc.h dclang_fast_math.h dclang_phiverb.h $(BELA_HOST):"$(BELA_HOME)/projects/$(BELA_PROJECT)/"
	ssh -o BatchMode=yes $(BELA_HOST) 'make -s -C "$(BELA_HOME)" PROJECT="$(BELA_PROJECT)" CPPFLAGS="$(BELA_CPPFLAGS)" CFLAGS="$(BELA_CPPFLAGS)"'

bela-run:
	ssh -o BatchMode=yes $(BELA_HOST) '"$(BELA_HOME)/scripts/run_project.sh" "$(BELA_PROJECT)"'

main.o libdclang.o: libdclang.c dclang.h dclang_dsp.h dclang_osc.h dclang_fast_math.h dclang_phiverb.h token.c

libdclang.o:
	$(CC) -c -fPIC -o $@ libdclang.c $(CFLAGS)

lib: libdclang.o
	$(CC) -shared $(LIBOBJ) -o $(LIBSOOBJ) $(LDFLAGS)

libtest: lib install
	$(CC) $(LIBTESTC) -o $@ $(LDDCLANG)

install: lib dclang
	mkdir -p $(PREFIX)/include $(PREFIX)/lib $(PREFIX)/bin
	cp -a $(HEADER) $(PREFIX)/include/
	cp -a $(LIBSOOBJ) $(PREFIX)/lib/
	rm -f $(PREFIX)/lib/dclang
	ln -s $(shell pwd)/lib $(PREFIX)/lib/dclang
	cp -a $(EXECUTABLE) $(PREFIX)/bin/

clean:
	rm -rf examples/*~ *~ dclang dclang2c libtest *.o *.so

docker-image:
	docker build --network host \
	             -t akjmicro17/dclang:latest --load \
	             -f contrib/Dockerfile \
	             .
